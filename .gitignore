# Competition rule 2.4.b forbids redistributing Competition Data to non-participants, and
# this repo is public. Nothing derived from train.csv - report text, label CSVs, extracted
# pixel data, fold assignments keyed to StudyInstanceUID - may be committed. All of data/
# stays out; redownload with scripts/download_data.py.
data/

# Checkpoints are large and are trained from Competition Data; publish via Kaggle Models.
checkpoints/
wandb/
lightning_logs/

# Submission CSVs contain per-study predictions keyed to test StudyInstanceUIDs.
submissions/
